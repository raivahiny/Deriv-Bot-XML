<strategy>
    <indicators>
        <!-- Indicateur MACD -->
        <indicator type="MACD">
            <fast_period>12</fast_period>
            <slow_period>26</slow_period>
            <signal_period>9</signal_period>
        </indicator>

        <!-- Indicateur RSI -->
        <indicator type="RSI">
            <period>14</period>
            <overbought>70</overbought>
            <oversold>30</oversold>
        </indicator>

        <!-- Indicateur ADX -->
        <indicator type="ADX">
            <period>14</period>
            <threshold>25</threshold>
        </indicator>
    </indicators>

    <logic>
        <!-- Logique pour un trade CALL -->
        <condition>
            <if>
                <and>
                    <macd>
                        <signal>above</signal>
                    </macd>
                    <rsi>
                        <value>below</value>
                        <level>70</level>
                    </rsi>
                    <adx>
                        <value>above</value>
                        <level>25</level>
                    </adx>
                </and>
            </if>
            <then>
                <action type="CALL" />
            </then>
        </condition>

        <!-- Logique pour un trade PUT -->
        <condition>
            <if>
                <and>
                    <macd>
                        <signal>below</signal>
                    </macd>
                    <rsi>
                        <value>above</value>
                        <level>30</level>
                    </rsi>
                    <adx>
                        <value>above</value>
                        <level>25</level>
                    </adx>
                </and>
            </if>
            <then>
                <action type="PUT" />
            </then>
        </condition>
    </logic>

    <trade_settings>
        <stake>1</stake>
        <duration>5</duration>
        <duration_unit>minutes</duration_unit>
    </trade_settings>
</strategy>
